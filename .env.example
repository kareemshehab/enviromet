# SQLite database file (created automatically)
DATABASE_URL=file:./enviromet.db
# Long random string used to sign auth tokens — change it in production
PAYLOAD_SECRET=change-me-to-a-long-random-string
# Canonical production domain for metadata, sitemap, structured data and Live Preview.
# Use the real HTTPS domain in production; do not use a preview deployment URL.
NEXT_PUBLIC_SERVER_URL=http://localhost:3000
# Public production deployments are indexable by default. Keep false before launch.
# Development and Vercel previews stay noindex regardless of this setting.
SEARCH_ENGINE_INDEXING=false
# Secret used by the preview route (draft mode)
PREVIEW_SECRET=change-me-preview-secret

# --- Production (Vercel) — set by deploy-vercel.bat, not needed locally ---
# Postgres connection string (Supabase "Transaction pooler"). When set, Postgres is used instead of SQLite.
# DATABASE_URI=postgresql://...
# Vercel Blob token for images (added automatically when the Blob store is connected to the project)
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...
